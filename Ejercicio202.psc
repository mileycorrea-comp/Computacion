Algoritmo Ejericio202
	Leer Z;
	Leer S;
	Leer Val1;
	Leer promedio;
	Leer promedio_cubo;
	
	Si promedio > 0;
	promedio = ((Z+S+VAL1)/3);
	promedio_cubo = (promedio)^3;
	Escribir " El promedio es: ", promedio;
	Escribir "El promedio al cubo es: ", promedio_cubo;
	Sino Escribir "El promedio es menor a 0";
FinSi
FinAlgoritmo